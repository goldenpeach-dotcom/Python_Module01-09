def find_max_items(inventory: dict[str, int]) -> list[tuple[str, int]]:
    max_list: list[tuple[str, int]] = []
    max_quantity = max(inventory.values())
    for key, values in inventory.items():
        if values == max_quantity:
            max_list.append((key, values))
    return max_list

