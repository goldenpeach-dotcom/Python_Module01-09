・consume_eventを削除せずにランダムに変えるバージョンを作る

def consume_event(
        events_list: list[tuple[str, str]]
        ) -> Generator[tuple[str, str], None, None]:
    shuffled = random.sample(events_list, len(events_list))
    for event in shuffled:
        yield event

def consume_event(
        events_list: list[tuple[str, str]]
        ) -> Generator[tuple[str, str], None, None]:
    shuffled = events_list.copy()
    random.shuffle(shuffled)
    for event in shuffled:
        yield event

